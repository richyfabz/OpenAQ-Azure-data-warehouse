# Copy to airflow/.env and fill in real values. Never commit .env.

# Airflow (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=

# Databricks connection (AIRFLOW_CONN_DATABRICKS_DEFAULT is assembled from these)
# Hostname only, no https:// prefix, e.g. adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Ingestion container config (forwarded by the DAG's DockerOperator)
OPENAQ_API_KEY=
AZURE_STORAGE_ACCOUNT_NAME=
OPENAQ_STATE_BACKEND=volume

# Optional Azure service principal for the ingestion container's
# DefaultAzureCredential (uncomment and fill all three together):
#AZURE_CLIENT_ID=
#AZURE_TENANT_ID=
#AZURE_CLIENT_SECRET=
